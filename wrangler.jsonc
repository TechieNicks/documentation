{
	"name": "documentation",
	"compatibility_date": "2026-09-11",
	"main": "worker/index.js",
	"assets": {
		"directory": "./",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "ENGAGEMENT_KV",
			"id": "822c32d7362f48558cd45e10165e44b3",
			"remote": true
		}
	],
	"vectorize": [
		{
			"binding": "VECTOR_INDEX",
			"index_name": "techienicks-docs"
		},
		{
			"binding": "VECTORIZE",
			"index_name": "techienicks-docs",
			"remote": true
		}
	]
}